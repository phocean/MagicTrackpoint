	<string>com.jcbaptiste.magictrackpoint</string>
	<key>CFBundleName</key>
	<string>MagicTrackpoint</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.2</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
